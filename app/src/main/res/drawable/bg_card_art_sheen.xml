<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle top light + lower vignette over artwork; rounded to the artwork's 16dp corners. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00000000" android:endColor="#2E000000" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
