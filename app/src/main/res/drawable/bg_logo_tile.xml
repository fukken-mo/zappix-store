<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="5dp" android:right="2dp">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#66000000" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#194F89"
                android:centerColor="#102A55"
                android:endColor="#071126" />
            <stroke android:width="2dp" android:color="#6CE8FF" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="8dp">
        <shape>
            <corners android:radius="15dp" />
            <gradient
                android:angle="270"
                android:startColor="#324C8DFF"
                android:endColor="#0018C8FF" />
            <stroke android:width="1dp" android:color="#6B7A5CFF" />
        </shape>
    </item>
</layer-list>
