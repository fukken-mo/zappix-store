<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action (Install / Update / Open). Activated = download in progress. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <gradient android:angle="0" android:startColor="#1288BE" android:endColor="#5541C4" />
            <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
            <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <gradient android:angle="0" android:startColor="#0E3556" android:endColor="#251F55" />
            <stroke android:width="1dp" android:color="@color/zx_stroke_strong" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <gradient android:angle="0" android:startColor="#0F4A73" android:endColor="#2E2A72" />
            <stroke android:width="1dp" android:color="#3A5F86" />
        </shape>
    </item>
</selector>
