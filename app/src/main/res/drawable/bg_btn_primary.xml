<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action (Install / Update / Open): raised brand gradient. Activated = download in progress. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_activated="true">
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#80000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="0" android:startColor="#1590C8" android:endColor="#5A45CC" />
                    <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#80000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
                    <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#59000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="0" android:startColor="#0F3A60" android:endColor="#28225C" />
                    <stroke android:width="1dp" android:color="#3A5F86" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#14FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#59000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="0" android:startColor="#125A8C" android:centerColor="#1C4A9A" android:endColor="#3A2F86" />
                    <stroke android:width="1dp" android:color="#4C7FB8" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#20FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
