<?xml version="1.0" encoding="utf-8"?>
<!--
  Card tile: baked lower shadow (bottom 4dp), navy glass face, top inner highlight.
  Focused: deeper shadow and a lighter face so the card feels raised toward the viewer.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:left="3dp" android:top="6dp" android:right="3dp">
                <shape><corners android:radius="22dp" /><solid android:color="#73000000" /></shape>
            </item>
            <item android:bottom="@dimen/zx_card_depth">
                <shape>
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="#22457A" android:centerColor="#173463" android:endColor="#10244A" />
                    <stroke android:width="1dp" android:color="#5A8FD4" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="@dimen/zx_card_depth">
                <shape>
                    <corners android:radius="21dp" />
                    <gradient android:angle="270" android:startColor="#30FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="3dp" android:top="5dp" android:right="3dp">
                <shape><corners android:radius="22dp" /><solid android:color="#4D000000" /></shape>
            </item>
            <item android:bottom="@dimen/zx_card_depth">
                <shape>
                    <corners android:radius="22dp" />
                    <gradient android:angle="270" android:startColor="#172E54" android:centerColor="#10223F" android:endColor="#0B182F" />
                    <stroke android:width="1dp" android:color="#2F5180" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="@dimen/zx_card_depth">
                <shape>
                    <corners android:radius="21dp" />
                    <gradient android:angle="270" android:startColor="#1CFFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
