<?xml version="1.0" encoding="utf-8"?>
<!-- Raised glass tile for the Details artwork: baked lower shadow, face, light rim, top sheen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="4dp" android:top="8dp" android:right="4dp">
        <shape><corners android:radius="24dp" /><solid android:color="#80000000" /></shape>
    </item>
    <item android:bottom="4dp">
        <shape>
            <corners android:radius="24dp" />
            <gradient android:angle="315" android:startColor="#1D3D6E" android:centerColor="#122A52" android:endColor="#0A1630" />
            <stroke android:width="1.5dp" android:color="#5A9BE0" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="6dp">
        <shape>
            <corners android:radius="22dp" />
            <gradient android:angle="270" android:startColor="#26FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
