<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action (Back): neutral raised glass; focus uses the shared brand treatment. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#80000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
                    <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape><corners android:radius="@dimen/zx_radius_m" /><solid android:color="#59000000" /></shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_m" />
                    <gradient android:angle="270" android:startColor="#162842" android:endColor="#0D1A2E" />
                    <stroke android:width="1dp" android:color="#34557D" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
                <shape>
                    <corners android:radius="12dp" />
                    <gradient android:angle="270" android:startColor="#18FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
