<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog surface: raised navy glass with a light rim and top sheen, matching the home header. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="16dp" android:insetTop="16dp" android:insetRight="16dp" android:insetBottom="16dp">
    <layer-list>
        <item>
            <shape>
                <corners android:radius="@dimen/zx_radius_l" />
                <gradient android:angle="270" android:startColor="#14284A" android:centerColor="#0E1D38" android:endColor="#0A1428" />
                <stroke android:width="1.5dp" android:color="#4A67D8FF" />
            </shape>
        </item>
        <item android:left="1.5dp" android:top="1.5dp" android:right="1.5dp">
            <shape>
                <corners android:radius="17dp" />
                <gradient android:angle="270" android:startColor="#1E18C8FF" android:centerColor="#0018C8FF" android:endColor="#0018C8FF" />
            </shape>
        </item>
    </layer-list>
</inset>
