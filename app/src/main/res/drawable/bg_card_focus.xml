<?xml version="1.0" encoding="utf-8"?>
<!-- Card focus ring: cyan outer + light inner ring, drawn entirely inside the card frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="@color/zx_cyan" />
        </shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape>
            <corners android:radius="19.5dp" />
            <stroke android:width="1.5dp" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
</layer-list>
