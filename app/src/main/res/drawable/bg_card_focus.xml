<?xml version="1.0" encoding="utf-8"?>
<!-- Card focus: cyan ring + light inner line + soft inner cyan glow, all inside the tile face. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="@dimen/zx_card_depth">
        <shape>
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="@color/zx_cyan" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="7dp">
        <shape>
            <corners android:radius="19dp" />
            <stroke android:width="1.5dp" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item android:left="4.5dp" android:top="4.5dp" android:right="4.5dp" android:bottom="8.5dp">
        <shape>
            <corners android:radius="17.5dp" />
            <stroke android:width="4dp" android:color="#3318C8FF" />
        </shape>
    </item>
</layer-list>
