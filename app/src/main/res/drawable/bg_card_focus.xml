<?xml version="1.0" encoding="utf-8"?>
<!--
  Icon-tile focus: cyan ring + light inner line + soft inner cyan-to-purple glow, all inside the
  tile face (bottom 4dp = baked depth), so nothing is drawn outside the tile or onto the title.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:bottom="@dimen/zx_card_depth">
        <shape>
            <corners android:radius="22dp" />
            <stroke android:width="3dp" android:color="@color/zx_cyan" />
        </shape>
    </item>
    <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="7dp">
        <shape>
            <corners android:radius="19dp" />
            <stroke android:width="1.5dp" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item android:left="4.5dp" android:top="4.5dp" android:right="4.5dp" android:bottom="8.5dp">
        <shape>
            <corners android:radius="17.5dp" />
            <stroke android:width="4dp" android:color="#3818C8FF" />
        </shape>
    </item>
    <item android:left="4.5dp" android:top="4.5dp" android:right="4.5dp" android:bottom="8.5dp">
        <shape>
            <corners android:radius="17.5dp" />
            <stroke android:width="7dp" android:color="#1A7A5CFF" />
        </shape>
    </item>
</layer-list>
