<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android" android:insetLeft="4dp" android:insetTop="6dp" android:insetRight="4dp" android:insetBottom="6dp">
    <selector>
        <item android:state_focused="true">
            <shape>
                <corners android:radius="@dimen/zx_radius_m" />
                <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
                <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
            </shape>
        </item>
        <item>
            <shape>
                <corners android:radius="@dimen/zx_radius_m" />
                <gradient android:angle="0" android:startColor="#125A8C" android:centerColor="#1C4A9A" android:endColor="#3A2F86" />
                <stroke android:width="1dp" android:color="#4C7FB8" />
            </shape>
        </item>
    </selector>
</inset>
