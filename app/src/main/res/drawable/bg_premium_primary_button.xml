<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true" android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient android:angle="0" android:startColor="#2A6BD8" android:endColor="#6A43D9" />
                    <stroke android:width="2dp" android:color="#E7F9FF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="90" android:startColor="#24315C7A" android:endColor="#00121B2B" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="18dp" />
                    <gradient android:angle="0" android:startColor="#18C8FF" android:centerColor="#4186FF" android:endColor="#765CFF" />
                    <stroke android:width="2dp" android:color="#F2FCFF" />
                </shape>
            </item>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="90" android:startColor="#2AFFFFFF" android:endColor="#061225" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#173A63" android:endColor="#32285E" />
            <stroke android:width="1dp" android:color="#39597B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient android:angle="0" android:startColor="#15314B" android:endColor="#262247" />
            <stroke android:width="1dp" android:color="#304C68" />
        </shape>
    </item>
</selector>