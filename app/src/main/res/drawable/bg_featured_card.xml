<?xml version="1.0" encoding="utf-8"?>
<!-- Featured strip: the ring is drawn inside the view's own bounds, so it can never be clipped. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_l" />
            <gradient android:angle="0" android:startColor="#2A1E6A9C" android:centerColor="#2A2A4AAE" android:endColor="#2A4A3AAE" />
            <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/zx_radius_l" />
            <gradient android:angle="0" android:startColor="#14203248" android:endColor="#14241E48" />
            <stroke android:width="1dp" android:color="@color/zx_stroke" />
        </shape>
    </item>
</selector>
