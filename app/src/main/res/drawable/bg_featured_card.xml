<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:startColor="#20203C55"
                android:centerColor="#24142D4A"
                android:endColor="#2613293A" />
            <stroke android:width="2dp" android:color="#8C63DFFF" />
            <padding android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:angle="0"
                android:startColor="#1518293B"
                android:endColor="#11101C2B" />
            <stroke android:width="1dp" android:color="#28364A63" />
        </shape>
    </item>
</selector>