<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <solid android:color="#55000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
                    <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="7dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="270" android:startColor="#40FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <solid android:color="#44000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="315" android:startColor="#183A67" android:endColor="#0D2447" />
                    <stroke android:width="2dp" android:color="@color/zx_selected_stroke" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <solid android:color="#33000000" />
                </shape>
            </item>
            <item android:bottom="3dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="315" android:startColor="#142D50" android:endColor="#0A1830" />
                    <stroke android:width="1dp" android:color="#4A4C7DAC" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
