<?xml version="1.0" encoding="utf-8"?>
<!-- Destructive action (Uninstall): red at rest and when focused, same light focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <gradient android:angle="0" android:startColor="@color/zx_danger" android:endColor="@color/zx_danger_deep" />
            <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/zx_radius_m" />
            <solid android:color="@color/zx_danger_surface" />
            <stroke android:width="1dp" android:color="@color/zx_danger_stroke" />
        </shape>
    </item>
</selector>
