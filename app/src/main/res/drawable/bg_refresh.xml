<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_pill" />
            <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
            <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="@dimen/zx_radius_pill" />
            <solid android:color="@color/zx_selected_fill" />
            <stroke android:width="1.5dp" android:color="@color/zx_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="@dimen/zx_radius_pill" />
            <gradient android:angle="0" android:startColor="@color/zx_surface" android:endColor="@color/zx_surface_raised" />
            <stroke android:width="1dp" android:color="@color/zx_stroke_strong" />
        </shape>
    </item>
</selector>
