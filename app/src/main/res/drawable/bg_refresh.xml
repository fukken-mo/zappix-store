<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <solid android:color="#66000000" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="0" android:startColor="@color/zx_cyan" android:centerColor="@color/zx_blue" android:endColor="@color/zx_purple" />
                    <stroke android:width="@dimen/zx_focus_ring" android:color="@color/zx_focus_ring" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <solid android:color="#55000000" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="315" android:startColor="#1B4B82" android:endColor="#10264A" />
                    <stroke android:width="1.5dp" android:color="#6B63DFFF" />
                </shape>
            </item>
            <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="9dp">
                <shape>
                    <corners android:radius="@dimen/zx_radius_pill" />
                    <gradient android:angle="270" android:startColor="#2FFFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
