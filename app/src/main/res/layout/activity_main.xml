<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_zappix">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="64dp"
        android:paddingTop="30dp"
        android:paddingEnd="64dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_logo_tile"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Zappix"
                    android:scaleType="centerInside"
                    android:src="@drawable/zappix_icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zappix"
                    android:textColor="#F7FAFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your apps. One place."
                    android:textColor="#8290A5"
                    android:textSize="13sp" />
            </LinearLayout>

            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/refreshButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_action_button"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="Refresh"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/freeTab" style="@style/ZappixTab" android:text="Free" />
            <TextView android:id="@+id/subscriptionTab" style="@style/ZappixTab" android:layout_marginStart="12dp" android:text="Subscription" />
            <TextView android:id="@+id/adultTab" style="@style/ZappixTab" android:layout_marginStart="12dp" android:text="Adult 18+" />
            <TextView
                android:id="@+id/toolsTab"
                style="@style/ZappixTab"
                android:layout_marginStart="12dp"
                android:text="Tools"
                android:visibility="gone" />
            <TextView
                android:id="@+id/updatesTab"
                style="@style/ZappixTab"
                android:layout_marginStart="12dp"
                android:text="Updates"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/sectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Free Apps"
            android:textColor="#F4F7FB"
            android:textSize="22sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:fadingEdge="none"
                android:requiresFadingEdge="none"
                android:paddingStart="20dp"
                android:paddingTop="24dp"
                android:paddingEnd="48dp"
                android:paddingBottom="20dp" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:indeterminateTint="#18C8FF" />
        </FrameLayout>

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#FF8A9A"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/detailsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FC03050A"
        android:clickable="true"
        android:focusable="false"
        android:descendantFocusability="afterDescendants"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="86dp"
            android:paddingTop="54dp"
            android:paddingEnd="86dp"
            android:paddingBottom="54dp">

            <FrameLayout
                android:layout_width="310dp"
                android:layout_height="310dp"
                android:background="@drawable/bg_logo_tile"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/detailArtworkFull"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="App artwork"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_app_placeholder"
                    android:clipToOutline="true"
                    android:outlineProvider="background" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="64dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="APP DETAILS"
                    android:textColor="#63DFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailNameFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="38sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailTypeFull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#7DE3FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detailDescriptionFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:ellipsize="end"
                    android:maxLines="5"
                    android:textColor="#C7D0DE"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/detailErrorFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#FF8A9A"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/installFullButton"
                        android:layout_width="170dp"
                        android:nextFocusLeft="@id/installFullButton"
                        android:nextFocusRight="@id/backFullButton"
                        android:nextFocusUp="@id/installFullButton"
                        android:nextFocusDown="@id/installFullButton"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_install_button"
                        android:focusable="true"
                        android:text="Install"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/backFullButton"
                        android:layout_width="130dp"
                        android:nextFocusLeft="@id/installFullButton"
                        android:nextFocusRight="@id/backFullButton"
                        android:nextFocusUp="@id/backFullButton"
                        android:nextFocusDown="@id/backFullButton"
                        android:layout_height="56dp"
                        android:layout_marginStart="16dp"
                        android:background="@drawable/bg_action_button"
                        android:focusable="true"
                        android:text="Back"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>