<?xml version="1.0" encoding="utf-8"?>
<!--
  Zappix home + Details on the 960x540dp TV canvas.
  Home vertical budget (worst case, Featured visible):
    28 safe + 48 header + 14 + 44 nav + 14 + 84 featured + 12 + 24 title + 4 + 232 row = 504dp,
  leaving the bottom 36dp (>= 27dp overscan) empty.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="@dimen/zx_safe_h"
        android:paddingTop="@dimen/zx_safe_v"
        android:paddingEnd="@dimen/zx_safe_h"
        android:paddingBottom="@dimen/zx_safe_v">

        <!-- Header: brand + Refresh -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zx_header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/zx_logo_tile"
                android:layout_height="@dimen/zx_logo_tile"
                android:background="@drawable/bg_logo_tile"
                android:padding="6dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/zx_brand"
                    android:scaleType="centerInside"
                    android:src="@drawable/zappix_icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/zx_brand"
                    android:textColor="@color/zx_text_primary"
                    android:textSize="@dimen/zx_text_brand"
                    android:textStyle="bold" />

                <TextView
                    style="@style/ZappixText.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/zx_tagline" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/refreshButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/zx_nav_pill_height"
                android:background="@drawable/bg_refresh"
                android:clickable="true"
                android:drawableStart="@drawable/ic_refresh"
                android:drawablePadding="@dimen/zx_icon_gap"
                android:drawableTint="@color/zx_btn_secondary_content"
                android:focusable="true"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:minWidth="140dp"
                android:paddingStart="14dp"
                android:paddingEnd="18dp"
                android:text="@string/zx_refresh"
                android:textColor="@color/zx_btn_secondary_content"
                android:textSize="@dimen/zx_text_control"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Category navigation: one pill style, vector icons, no per-category colours. -->
        <LinearLayout
            android:id="@+id/navRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zx_nav_row_height"
            android:layout_marginTop="@dimen/zx_section_gap"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/freeTab"
                style="@style/ZappixNavPill"
                android:drawableStart="@drawable/ic_nav_free"
                android:text="@string/zx_nav_free" />

            <TextView
                android:id="@+id/subscriptionTab"
                style="@style/ZappixNavPill"
                android:drawableStart="@drawable/ic_nav_subscription"
                android:text="@string/zx_nav_subscription" />

            <TextView
                android:id="@+id/adultTab"
                style="@style/ZappixNavPill"
                android:drawableStart="@drawable/ic_nav_adult"
                android:text="@string/zx_nav_adult"
                android:visibility="gone" />

            <TextView
                android:id="@+id/toolsTab"
                style="@style/ZappixNavPill"
                android:drawableStart="@drawable/ic_nav_tools"
                android:text="@string/zx_nav_tools"
                android:visibility="gone" />

            <TextView
                android:id="@+id/updatesTab"
                style="@style/ZappixNavPill"
                android:drawableStart="@drawable/ic_nav_updates"
                android:text="@string/zx_nav_updates"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Featured strip (Free section only) -->
        <LinearLayout
            android:id="@+id/featuredCard"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zx_featured_height"
            android:layout_marginTop="@dimen/zx_section_gap"
            android:background="@drawable/bg_featured_card"
            android:clickable="true"
            android:baselineAligned="false"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:nextFocusLeft="@id/featuredCard"
            android:nextFocusRight="@id/featuredCard"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/featuredArtwork"
                android:layout_width="@dimen/zx_featured_art"
                android:layout_height="@dimen/zx_featured_art"
                android:background="@drawable/bg_app_placeholder"
                android:contentDescription="@string/zx_featured_app"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ZappixText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/ic_featured"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/zx_cyan_soft"
                    android:gravity="center_vertical"
                    android:text="@string/zx_featured" />

                <TextView
                    android:id="@+id/featuredName"
                    style="@style/ZappixText.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/featuredDescription"
                    style="@style/ZappixText.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:textColor="@color/zx_text_secondary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_chip"
                android:drawableEnd="@drawable/ic_action_open"
                android:drawablePadding="4dp"
                android:drawableTint="@color/zx_cyan_soft"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="8dp"
                android:text="@string/zx_view"
                android:textColor="@color/zx_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Section title + inline status (error never pushes the row down) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sectionTitle"
                style="@style/ZappixText.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/zx_section_free" />

            <TextView
                android:id="@+id/errorText"
                style="@style/ZappixText.Error"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>

        <!-- App row: runs edge to edge; padding keeps the first and focused card in the safe area. -->
        <FrameLayout
            android:id="@+id/rowContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/zx_row_height"
            android:layout_marginStart="-56dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="-56dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsRecycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:paddingStart="@dimen/zx_safe_h"
                android:paddingTop="@dimen/zx_row_pad_top"
                android:paddingEnd="@dimen/zx_row_pad_end"
                android:paddingBottom="@dimen/zx_row_pad_bottom"
                android:requiresFadingEdge="none"
                android:scrollbars="none" />

            <ProgressBar
                android:id="@+id/loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/zx_cyan" />

            <TextView
                android:id="@+id/emptyText"
                style="@style/ZappixText.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/zx_empty_section"
                android:textColor="@color/zx_text_muted"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!--
      Details on the 960x540dp canvas: 56dp sides, 36dp top/bottom.
      Column budget (worst case): 16 + 6 + 40 + 8 + 24 + 12 + 66 + 14 + 76 + 10 + 38 + 12 + 26 + 20 + 52 = 420dp of 468dp.
    -->
    <FrameLayout
        android:id="@+id/detailsOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_details_scrim"
        android:clickable="true"
        android:descendantFocusability="afterDescendants"
        android:focusable="false"
        android:visibility="gone"
        tools:ignore="KeyboardInaccessibleWidget">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/zx_details_safe_h"
            android:paddingTop="@dimen/zx_details_safe_v"
            android:paddingEnd="@dimen/zx_details_safe_h"
            android:paddingBottom="@dimen/zx_details_safe_v">

            <FrameLayout
                android:id="@+id/detailArtworkTile"
                android:layout_width="@dimen/zx_details_art_tile"
                android:layout_height="@dimen/zx_details_art_tile"
                android:background="@drawable/bg_logo_tile"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/detailArtworkFull"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_app_placeholder"
                    android:contentDescription="@string/zx_app_artwork"
                    android:outlineProvider="background"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/detailColumn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/zx_details_column_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/ZappixText.Overline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/zx_app_details" />

                <TextView
                    android:id="@+id/detailNameFull"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/zx_text_primary"
                    android:textSize="@dimen/zx_text_details_title"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailTypeFull"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@drawable/bg_chip"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:maxLines="1"
                        android:maxWidth="220dp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:textColor="@color/zx_cyan_soft"
                        android:textSize="@dimen/zx_text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailMetaFull"
                        style="@style/ZappixText.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailDescriptionFull"
                    style="@style/ZappixText.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:maxLines="3" />

                <LinearLayout
                    android:id="@+id/detailScreenshotsRow"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/zx_shot_height"
                    android:layout_marginTop="14dp"
                    android:gravity="start|center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/detailScreenshot1"
                        android:layout_width="@dimen/zx_shot_width"
                        android:layout_height="@dimen/zx_shot_height"
                        android:background="@drawable/bg_screenshot"
                        android:contentDescription="@string/zx_screenshot"
                        android:outlineProvider="background"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/detailScreenshot2"
                        android:layout_width="@dimen/zx_shot_width"
                        android:layout_height="@dimen/zx_shot_height"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_screenshot"
                        android:contentDescription="@string/zx_screenshot"
                        android:outlineProvider="background"
                        android:scaleType="centerCrop" />

                    <ImageView
                        android:id="@+id/detailScreenshot3"
                        android:layout_width="@dimen/zx_shot_width"
                        android:layout_height="@dimen/zx_shot_height"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_screenshot"
                        android:contentDescription="@string/zx_screenshot"
                        android:outlineProvider="background"
                        android:scaleType="centerCrop" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detailErrorFull"
                    style="@style/ZappixText.Error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:maxLines="2"
                    android:visibility="gone" />

                <!-- Download progress (visible only while this app downloads) -->
                <LinearLayout
                    android:id="@+id/detailProgressGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/detailProgress"
                        style="@style/ZappixProgress"
                        android:layout_width="match_parent" />

                    <TextView
                        android:id="@+id/detailProgressLabel"
                        style="@style/ZappixText.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/zx_text_secondary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/detailButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/installFullButton"
                        style="@style/ZappixButton.Primary"
                        android:drawableStart="@drawable/ic_action_install"
                        android:nextFocusDown="@id/installFullButton"
                        android:nextFocusLeft="@id/installFullButton"
                        android:nextFocusRight="@id/backFullButton"
                        android:nextFocusUp="@id/installFullButton"
                        android:text="@string/zx_install" />

                    <Button
                        android:id="@+id/uninstallFullButton"
                        style="@style/ZappixButton.Destructive"
                        android:layout_marginStart="@dimen/zx_button_gap"
                        android:drawableStart="@drawable/ic_action_uninstall"
                        android:nextFocusDown="@id/uninstallFullButton"
                        android:nextFocusLeft="@id/installFullButton"
                        android:nextFocusRight="@id/backFullButton"
                        android:nextFocusUp="@id/uninstallFullButton"
                        android:text="@string/zx_uninstall"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/backFullButton"
                        style="@style/ZappixButton.Secondary"
                        android:layout_marginStart="@dimen/zx_button_gap"
                        android:drawableStart="@drawable/ic_action_back"
                        android:nextFocusDown="@id/backFullButton"
                        android:nextFocusLeft="@id/installFullButton"
                        android:nextFocusRight="@id/backFullButton"
                        android:nextFocusUp="@id/backFullButton"
                        android:text="@string/zx_back" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
