<?xml version="1.0" encoding="utf-8"?>
<!--
  App card. The focus ring is drawn inside the 168dp frame (the artwork is inset by 4dp), and
  focus scales the card by at most 1.03, so nothing is ever drawn outside the row's padding.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/zx_card_width"
    android:layout_height="@dimen/zx_card_height"
    android:layout_marginEnd="@dimen/zx_card_gap"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/zx_card_pad">

    <FrameLayout
        android:id="@+id/cardFrame"
        android:layout_width="@dimen/zx_card_frame"
        android:layout_height="@dimen/zx_card_frame">

        <ImageView
            android:id="@+id/appArtwork"
            android:layout_width="@dimen/zx_card_art"
            android:layout_height="@dimen/zx_card_art"
            android:layout_gravity="center"
            android:background="@drawable/bg_app_placeholder"
            android:importantForAccessibility="no"
            android:outlineProvider="background"
            android:scaleType="centerCrop" />

        <View
            android:id="@+id/focusFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@drawable/bg_card_focus"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/installedBadge"
            style="@style/ZappixBadge"
            android:layout_gravity="top|end"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_installed_badge"
            android:text="@string/zx_badge_installed"
            android:textColor="@color/zx_badge_installed_text"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/appName"
        android:layout_width="match_parent"
        android:layout_height="@dimen/zx_card_name_height"
        android:alpha="0.8"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:textColor="@color/zx_text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
