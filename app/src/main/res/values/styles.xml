<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zappix" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <!-- The branded background is the window background: one full-screen layer, shown from cold start. -->
        <item name="android:windowBackground">@drawable/bg_zappix</item>
        <item name="android:colorAccent">@color/zx_cyan</item>
        <item name="android:navigationBarColor">@color/zx_bg_bottom</item>
        <item name="android:statusBarColor">@color/zx_bg_bottom</item>
    </style>

    <!-- Dialogs: same surfaces, type and focus language as the rest of Zappix. -->
    <style name="Theme.Zappix.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorAccent">@color/zx_cyan</item>
        <item name="android:textColorPrimary">@color/zx_text_primary</item>
        <item name="android:textColorSecondary">@color/zx_text_secondary</item>
        <item name="android:windowTitleStyle">@style/ZappixDialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/ZappixDialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/ZappixDialogButton.Primary</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/ZappixDialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/ZappixDialogButton</item>
    </style>

    <style name="ZappixDialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/zx_text_primary</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ZappixDialogButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:background">@drawable/bg_dialog_button_secondary</item>
        <item name="android:textColor">@color/zx_btn_secondary_content</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/zx_text_control</item>
        <item name="android:minWidth">112dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="ZappixDialogButton.Primary">
        <item name="android:background">@drawable/bg_dialog_button_primary</item>
        <item name="android:textColor">@color/zx_btn_primary_content</item>
    </style>

    <!-- Category pill: vector icon + label, one focus treatment for every category. -->
    <style name="ZappixNavPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">@dimen/zx_nav_pill_height</item>
        <item name="android:layout_marginEnd">@dimen/zx_nav_pill_gap</item>
        <item name="android:background">@drawable/bg_nav_pill</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:drawablePadding">@dimen/zx_icon_gap</item>
        <item name="android:drawableTint">@color/zx_nav_content</item>
        <item name="android:textColor">@color/zx_nav_text</item>
        <item name="android:textSize">@dimen/zx_text_control</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Details buttons -->
    <style name="ZappixButton" parent="android:Widget.Material.Button">
        <item name="android:layout_height">@dimen/zx_button_height</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:minHeight">@dimen/zx_button_height</item>
        <item name="android:maxLines">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ZappixButton.Primary">
        <item name="android:minWidth">184dp</item>
        <item name="android:background">@drawable/bg_btn_primary</item>
        <item name="android:textColor">@color/zx_btn_primary_content</item>
        <item name="android:drawableTint">@color/zx_btn_primary_content</item>
    </style>

    <style name="ZappixButton.Secondary">
        <item name="android:minWidth">124dp</item>
        <item name="android:background">@drawable/bg_btn_secondary</item>
        <item name="android:textColor">@color/zx_btn_secondary_content</item>
        <item name="android:drawableTint">@color/zx_btn_secondary_content</item>
    </style>

    <style name="ZappixButton.Destructive">
        <item name="android:minWidth">152dp</item>
        <item name="android:background">@drawable/bg_btn_destructive</item>
        <item name="android:textColor">@color/zx_btn_destructive_content</item>
        <item name="android:drawableTint">@color/zx_btn_destructive_content</item>
    </style>

    <!-- Text -->
    <style name="ZappixText" />

    <style name="ZappixText.Overline">
        <item name="android:textColor">@color/zx_cyan_soft</item>
        <item name="android:textSize">@dimen/zx_text_overline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="ZappixText.Title">
        <item name="android:textColor">@color/zx_text_primary</item>
        <item name="android:textSize">@dimen/zx_text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ZappixText.Body">
        <item name="android:textColor">@color/zx_text_secondary</item>
        <item name="android:textSize">@dimen/zx_text_body</item>
        <item name="android:lineSpacingExtra">3sp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ZappixText.Caption">
        <item name="android:textColor">@color/zx_text_muted</item>
        <item name="android:textSize">@dimen/zx_text_caption</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ZappixText.Error">
        <item name="android:textColor">@color/zx_text_error</item>
        <item name="android:textSize">13sp</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ZappixBadge">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="ZappixProgress" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_height">@dimen/zx_progress_height</item>
        <item name="android:minHeight">@dimen/zx_progress_height</item>
        <item name="android:maxHeight">@dimen/zx_progress_height</item>
        <item name="android:progressDrawable">@drawable/bg_progress</item>
        <item name="android:indeterminateTint">@color/zx_cyan</item>
        <item name="android:max">100</item>
    </style>
</resources>
