<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Zappix" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#03050A</item>
        <item name="android:colorAccent">#18C8FF</item>
        <item name="android:navigationBarColor">#03050A</item>
        <item name="android:statusBarColor">#03050A</item>
    </style>

    <style name="ZappixTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:background">@drawable/bg_tab</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>